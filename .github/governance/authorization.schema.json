{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bootstrap Governance v0 Merge Authorization",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "authorization_id", "timestamp", "implementation_agent_id", "lead_agent_id", "release_agent_id", "ci_run_id", "gate_record_commits", "repository", "head_repository", "pr_number", "pr_state", "merged", "base_branch", "base_sha", "head_branch", "candidate_sha", "candidate_tree", "remote_base_sha", "remote_candidate_sha", "base_is_ancestor", "ci_workflow_name", "ci_workflow_path", "ci_event", "ci_pr_number", "ci_candidate_sha", "ci_status", "ci_conclusion"],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "Bootstrap Governance v0 Merge Authorization"},
    "authorization_id": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "implementation_agent_id": {"type": "string", "minLength": 1},
    "lead_agent_id": {"type": "string", "minLength": 1},
    "release_agent_id": {"type": "string", "minLength": 1},
    "repository": {"const": "FlorisOrd/tailor"},
    "head_repository": {"const": "FlorisOrd/tailor"},
    "pr_number": {"const": 1},
    "pr_state": {"const": "open"},
    "merged": {"const": false},
    "base_branch": {"const": "main"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "head_branch": {"const": "bootstrap/agent-company"},
    "candidate_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "remote_base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "remote_candidate_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "base_is_ancestor": {"const": true},
    "ci_run_id": {"type": "integer", "minimum": 1},
    "ci_workflow_name": {"const": "Governance Baseline"},
    "ci_workflow_path": {"const": ".github/workflows/governance.yml"},
    "ci_event": {"const": "pull_request"},
    "ci_pr_number": {"const": 1},
    "ci_candidate_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "ci_status": {"const": "completed"},
    "ci_conclusion": {"const": "success"},
    "gate_record_commits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Independent Code Review", "QA", "Security Review", "Release"],
      "properties": {
        "Independent Code Review": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "QA": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "Security Review": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "Release": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    }
  }
}
