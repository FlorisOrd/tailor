{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FlorisOrd/tailor/.github/governance/legacy-evidence-binding.schema.json",
  "title": "Legacy Evidence Binding",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "binding_id", "record_type", "pr_number", "legacy_gate_record_id", "legacy_schema_version", "legacy_comment_id", "legacy_comment_url", "legacy_agent_id", "legacy_gate_type", "legacy_base_sha", "legacy_candidate_sha", "legacy_candidate_tree", "legacy_disposition", "legacy_record", "canonical_json_sha256", "raw_comment_sha256", "observed_at", "migration_agent_id", "migration_candidate_sha", "migration_candidate_tree", "provenance_only", "not_approval"],
  "properties": {
    "schema_version": {"const": 1},
    "binding_id": {"type": "string", "pattern": "^LEGACY-BINDING-[A-Z0-9-]+$"},
    "record_type": {"const": "Legacy Evidence Binding"},
    "pr_number": {"type": "integer", "minimum": 1},
    "legacy_gate_record_id": {"type": "string", "pattern": "^GATE-[A-Z0-9-]+$"},
    "legacy_schema_version": {"const": 1},
    "legacy_comment_id": {"type": "integer", "minimum": 1},
    "legacy_comment_url": {"type": "string", "pattern": "^https://github.com/"},
    "legacy_agent_id": {"type": "string", "minLength": 1},
    "legacy_gate_type": {"enum": ["Independent Code Review", "QA", "Security Review", "Release"]},
    "legacy_base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "legacy_candidate_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "legacy_candidate_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "legacy_disposition": {"enum": ["PASS", "FAIL", "PENDING", "N/A"]},
    "legacy_record": {"type": "object"},
    "canonical_json_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "raw_comment_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "observed_at": {"type": "string", "format": "date-time"},
    "migration_agent_id": {"type": "string", "minLength": 1},
    "migration_candidate_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "migration_candidate_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "provenance_only": {"const": true},
    "not_approval": {"const": true}
  }
}
