    "exact_integration": "GOV-EXACT-INTEGRATION",
    "gate_records": "GOV-GATE-RECORDS",
    "stale_evidence": "GOV-STALE-EVIDENCE",
    "high_risk_staging": "GOV-HIGH-RISK-STAGING",
