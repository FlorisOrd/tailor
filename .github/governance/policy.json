  },
  "roles": {
    "required": ["Implementation", "Independent Code Review", "QA", "Release"],
    "mutually_distinct": ["Implementation", "Independent Code Review", "QA", "Release"],
    "security_distinct_from": ["Implementation", "Lead / Engineering Manager", "QA", "Release"],
    "release_only_authorities": ["Authorization to Merge", "Authorization to Deploy"]
  },
  "non_waivable_controls": ["GOV-ROLE-SEPARATION", "GOV-SECURITY-INDEPENDENCE", "GOV-EXACT-INTEGRATION", "GOV-GATE-RECORDS", "GOV-STALE-EVIDENCE", "GOV-HIGH-RISK-STAGING", "GOV-OWNER-PROTECTION", "GOV-RELEASE-AUTHORITY", "secret_protection", "blocking_major_recheck"] ,
  "severity": {
    "BLOCKING": {"blocks": true, "requires_independent_recheck": true},
    "MAJOR": {"blocks": true, "requires_independent_recheck": true},
    "MINOR": {"blocks": false, "requires_debt_owner_and_target": true},
    "SUGGESTION": {"blocks": false, "requires_disposition": true}
  },
  "evidence": {
    "formal_gate_types": ["Independent Code Review", "QA", "Security Review", "Release"],
    "publisher_must_be_performing_agent": true,
    "pr_body_is_authoritative": false,
    "candidate_identity_fields": ["base_sha", "candidate_sha", "candidate_tree"],
    "required_gate_record_fields": ["schema_version", "gate_record_id", "gate_type", "agent_role", "agent_id", "pr_number", "base_sha", "candidate_sha", "candidate_tree", "timestamp", "scope", "checks", "findings", "repair_claims", "rechecks", "disposition", "repository_state_changed", "supersedes"],
    "required_finding_fields": ["finding_id", "severity", "summary", "status"],
    "required_repair_claim_fields": ["source_gate_record_id", "source_finding_id", "repaired_candidate_sha", "summary"],
    "required_recheck_fields": ["source_gate_record_id", "source_finding_id", "repair_gate_record_id", "rechecked_candidate_sha", "outcome"],
    "finding_severities": ["BLOCKING", "MAJOR", "MINOR", "SUGGESTION"],
    "finding_statuses": ["OPEN"],
    "append_only_graph": {"backward_edges_only": true, "predecessor_never_mutated": true, "acyclic": true, "no_forks": true, "same_gate_type_for_supersession": true, "same_pr": true, "ordered_timestamp": true, "missing_predecessor_fails": true},
    "finding_lifecycle": {"repair_claim_does_not_close": true, "closure_requires_distinct_rechecker": true, "closure_requires_exact_source_finding": true, "closure_requires_repaired_candidate": true, "failed_recheck_remains_open": true, "wrong_role_cannot_recheck": true},
    "content_addressing": {"required": true, "storage": "immutable_git_commit", "canonical_ref_prefix": "refs/governance/gate-records/", "comment_must_match_stored_json": true, "commit_parent_is_candidate": true},
    "live_reconciliation": {"github_pr_comments_required": true, "complete_remote_ref_discovery": true, "origin_queried_at_validation_time": true, "local_ref_subset_not_authoritative": true, "source_disagreement_fails": true, "missing_history_fails": true}
  },
  "stale_evidence": {
    "candidate_change_invalidates": true,
    "repair_creates_new_candidate": true,
    "unaffected_requires_independent_gate_owner_record": true
  },
  "integration": {
    "merge_commit_only": true,
    "parent_count": 2,
    "exact_first_parent_is_authorized_base": true,
    "exact_second_parent_is_authorized_candidate": true,
    "candidate_tree_equals_authorized_tree": true,
    "integration_tree_equals_authorized_tree": true,
    "authorization_source": "immutable_git_authorization_commit",
    "authorization_ref_prefix": "refs/governance/authorizations/",
    "integration_trailer": "Governance-Authorization",
    "pr_trailer": "Governance-PR",
    "authorization_required_fields": ["schema_version", "authorization_id", "pr_number", "base_sha", "candidate_sha", "candidate_tree", "timestamp", "release_agent_id", "release_gate_record_id", "gate_record_commits"],
    "canonical_ref_must_equal_authorization": true,
    "authorization_commit_parent_is_candidate": true,
    "release_identity_fields": ["base_sha", "candidate_sha", "candidate_tree", "authorization_commit_sha", "canonical_authorization_ref", "integration_sha", "integration_tree"]
  },
  "high_risk_staging": {
    "required": true,
    "non_local": true,
    "isolated": true,
    "local_substitute_allowed": false,
    "categories": ["authentication", "authorization", "billing", "personal_data", "persisted_data_migration", "infrastructure", "deployment_security_boundary", "security_sensitive_behavior"]
  },
  "owner_boundaries": {
    "owner_does_not": ["edit_code", "run_commands", "perform_git_operations", "resolve_conflicts", "inspect_logs", "interpret_logs", "debug", "maintain_code"],
    "ask_only_for": ["product_behavior", "ux", "branding", "business", "spending", "privacy", "legal_compliance", "irreversible_external_action"],
    "routine_technical_autonomy": "agents"
