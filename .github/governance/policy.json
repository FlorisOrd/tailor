    "non_waivable_controls_may_be_excepted": false
  },
  "release": {
    "release_role_issues_authorization": true,
    "authorization_is_candidate_specific": true,
    "authorization_requires_current_gate_records": true,
    "merge_and_deploy_authorizations_are_separate": true,
    "required_gate_record_types": ["Independent Code Review", "QA", "Security Review"]
  },
  "finding_policy": {
    "approval_blocking_severities": ["BLOCKING", "MAJOR"],
    "repair_required_severities": ["BLOCKING", "MAJOR"],
    "independent_recheck_required_severities": ["BLOCKING", "MAJOR"],
    "minor_requires_debt_owner_and_target": true,
    "suggestion_requires_disposition": true
  }
