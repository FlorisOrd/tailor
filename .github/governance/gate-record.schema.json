{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bootstrap Governance v0 Gate Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "gate_record_id", "gate_type", "agent_role", "agent_id", "publisher_agent_id", "pr_number", "base_sha", "candidate_sha", "candidate_tree", "timestamp", "scope", "checks", "findings", "disposition"],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "Bootstrap Governance v0 Gate Record"},
    "gate_record_id": {"type": "string", "pattern": "^BOOTSTRAP-GATE-[A-Z0-9-]+$"},
    "gate_type": {"enum": ["Independent Code Review", "QA", "Security Review", "Release"]},
    "agent_role": {"enum": ["Independent Code Review", "QA", "Security Review", "Release"]},
    "agent_id": {"type": "string", "minLength": 1},
    "publisher_agent_id": {"type": "string", "minLength": 1},
    "pr_number": {"type": "integer", "minimum": 1},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "scope": {"type": "string", "minLength": 1},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "findings": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["finding_id", "severity", "summary"], "properties": {"finding_id": {"type": "string", "minLength": 1}, "severity": {"enum": ["BLOCKING", "MAJOR", "MINOR", "SUGGESTION"]}, "summary": {"type": "string", "minLength": 1}}}},
    "disposition": {"enum": ["PASS", "FAIL"]}
  }
}
